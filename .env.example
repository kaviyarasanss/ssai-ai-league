# Copy this file to .env and paste your real key there.
# .env is gitignored; .env.example is safe to commit.
GEMINI_API_KEY=paste-your-key-here

# Free tier is ~20 requests/day PER MODEL on newest models, far more on
# older 'lite' ones. So we split the work:
#   GEMINI_MODEL       - the workhorse. Every normal call.
#   GEMINI_JUDGE_MODEL - Week 6 only, where answer quality is graded.
# Pinned (not '-latest') so Week 6 before/after scores stay comparable.
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=models/gemini-3.8-flash
